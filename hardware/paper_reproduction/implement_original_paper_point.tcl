# Vivado 2019.2 full OOC implementation for one original-vPIFO paper point.
#
# This consumes the checkpoint generated by synth_original_paper_point.tcl.
# Default implementation directives are intentional: the public repository
# does not contain the authors' Vivado project/strategy, so the least-assuming
# reproduction is the Vivado default flow.
#
# Usage:
#   vivado -mode batch -source implement_original_paper_point.tcl -tclargs \
#       <SYNTH_DCP> <RUN_TAG> ?default|explore?

set exp_dir [file dirname [file normalize [info script]]]

if {($argc < 2) || ($argc > 3)} {
    error "expected: <SYNTH_DCP> <RUN_TAG> ?default|explore?"
}

set synth_dcp [file normalize [lindex $argv 0]]
set run_tag [lindex $argv 1]
set strategy [expr {$argc == 3 ? [lindex $argv 2] : "default"}]

if {![file isfile $synth_dcp]} {
    error "synthesis checkpoint does not exist: $synth_dcp"
}
if {![regexp {^[A-Za-z0-9_]+$} $run_tag]} {
    error "RUN_TAG may contain only letters, digits, and underscores"
}
if {$strategy ni {default explore}} {
    error "strategy must be default or explore"
}

proc extract_utilization_metric {report_text row_name} {
    set escaped_name [regsub -all {([][(){}.+*?^$\\|])} $row_name {\\\1}]
    set pattern "^\\|\\s*$escaped_name\\*?\\s*\\|\\s*([0-9,]+)"
    if {[regexp -line -- $pattern $report_text unused value]} {
        return [string map {, ""} $value]
    }
    return "UNKNOWN"
}

set build_dir [file join $exp_dir runs $run_tag]
set report_dir [file join $build_dir reports]
file mkdir $build_dir
file mkdir $report_dir

set_param general.maxThreads 8
open_checkpoint $synth_dcp

set clock_object [get_clocks vpifo_clk]
if {[llength $clock_object] != 1} {
    error "expected exactly one vpifo_clk in synthesis checkpoint"
}
set clock_period_ns [get_property PERIOD $clock_object]

if {$strategy eq "default"} {
    opt_design
    place_design
    route_design
    set opt_directive "Default"
    set place_directive "Default"
    set phys_opt_directive "NotRun"
    set route_directive "Default"
} else {
    opt_design -directive Explore
    place_design -directive Explore
    phys_opt_design -directive Explore
    route_design -directive Explore
    set opt_directive "Explore"
    set place_directive "Explore"
    set phys_opt_directive "Explore"
    set route_directive "Explore"
}

set routed_dcp [file join $build_dir "${run_tag}_routed.dcp"]
write_checkpoint -force $routed_dcp

set timing_summary_file [file join $report_dir \
    "${run_tag}_post_route_timing_summary.rpt"]
set utilization_file [file join $report_dir \
    "${run_tag}_post_route_utilization.rpt"]
report_timing_summary -delay_type min_max -report_unconstrained \
    -file $timing_summary_file
report_timing -delay_type max -max_paths 100 -nworst 1 \
    -path_type full_clock_expanded -file [file join $report_dir \
    "${run_tag}_post_route_top100_paths.rpt"]
report_utilization -file $utilization_file
report_utilization -hierarchical -file [file join $report_dir \
    "${run_tag}_post_route_utilization_hierarchical.rpt"]
report_route_status -file [file join $report_dir \
    "${run_tag}_route_status.rpt"]

set utilization_text [report_utilization -return_string]
set clb_luts [extract_utilization_metric $utilization_text "CLB LUTs"]
set logic_luts [extract_utilization_metric $utilization_text "LUT as Logic"]
set lutram_luts [extract_utilization_metric $utilization_text "LUT as Memory"]
set registers [extract_utilization_metric $utilization_text "CLB Registers"]

set summary_handle [open [file join $report_dir \
    "${run_tag}_post_route_machine_summary.txt"] w]
puts $summary_handle "STAGE=POST_ROUTE"
puts $summary_handle "VIVADO_VERSION=[version -short]"
puts $summary_handle "SOURCE_DCP=$synth_dcp"
puts $summary_handle "TOP=[get_property TOP [current_design]]"
puts $summary_handle "PART=[get_property PART [current_design]]"
puts $summary_handle "CLOCK_PERIOD_NS=$clock_period_ns"
puts $summary_handle "IMPLEMENTATION_STRATEGY=$strategy"
puts $summary_handle "OPT_DIRECTIVE=$opt_directive"
puts $summary_handle "PLACE_DIRECTIVE=$place_directive"
puts $summary_handle "PHYS_OPT_DIRECTIVE=$phys_opt_directive"
puts $summary_handle "ROUTE_DIRECTIVE=$route_directive"
puts $summary_handle "CLB_LUT=$clb_luts"
puts $summary_handle "LUT_AS_LOGIC=$logic_luts"
puts $summary_handle "LUT_AS_MEMORY=$lutram_luts"
puts $summary_handle "CLB_REGISTERS=$registers"

set worst_path [get_timing_paths -delay_type max -max_paths 1 -nworst 1]
if {[llength $worst_path] == 0} {
    puts $summary_handle "NO_SETUP_PATH=1"
} else {
    set worst_path [lindex $worst_path 0]
    set wns [get_property SLACK $worst_path]
    set achieved_period [expr {$clock_period_ns - $wns}]
    puts $summary_handle "WNS=$wns"
    puts $summary_handle \
        "STARTPOINT=[get_property STARTPOINT_PIN $worst_path]"
    puts $summary_handle \
        "ENDPOINT=[get_property ENDPOINT_PIN $worst_path]"
    puts $summary_handle \
        "DATAPATH_DELAY=[get_property DATAPATH_DELAY $worst_path]"
    puts $summary_handle \
        "LOGIC_LEVELS=[get_property LOGIC_LEVELS $worst_path]"
    puts $summary_handle "ACHIEVED_PERIOD_NS=$achieved_period"
    puts $summary_handle \
        "ESTIMATED_FMAX_MHZ=[expr {1000.0 / $achieved_period}]"
}

set violating_paths [get_timing_paths -delay_type max \
    -slack_lesser_than 0.0 -max_paths 200000 -nworst 1]
set tns 0.0
foreach timing_path $violating_paths {
    set tns [expr {$tns + [get_property SLACK $timing_path]}]
}
puts $summary_handle "TNS=$tns"
puts $summary_handle "VIOLATING_ENDPOINTS=[llength $violating_paths]"
puts $summary_handle "ROUTED_DCP=$routed_dcp"
close $summary_handle

puts "PASS: original-paper post-route reports written to $report_dir"
